# Заголовки Pages. Файл попадает в dist как есть и читается Cloudflare Pages при
# отдаче; вне Pages — то есть на nginx/Caddy — его роль играет конфигурация
# сервера (docs/FRONTEND_HOSTING.md), поэтому здесь только то, что не ломает
# перенос: статические правила отдачи.
#
# Список внешних узлов в CSP собран не по шаблону: его дали строки собранного
# бандла (grep https:// dist/assets/*.js) и транспорты wagmi. Одного грёма мало,
# и это измерено: oauth.telegram.org, куда виджет входа ставит свой iframe, в
# бандле не встречается ни разу (0 совпадений по dist/assets/*.js) — адрес
# рождается внутри telegram-widget.js при клике. Поэтому список доверян тем, что
# показал браузер. Проверка — `npm run check:headers`: она поднимает dist с этими
# заголовками, проходит девять панелей и модальное окно кошелька, требует нуля
# заблокированных запросов и печатает то, что сломало бы enforce.

# Файлы с хэшем в имени неизменяемы по построению: новое содержимое — новое имя.
# Без этой строки Pages отдаёт их с max-age=0, must-revalidate — живой замер
# 2026-11-17: `assets/index-o3W-CAb1.js` отвечает 200 с ETag, а повтор с
# If-None-Match даёт 304. Значит заново едет не тело (0.83 МиБ на 19 JS-файлов
# и CSS этого билда), а отдельный условный запрос на каждый файл при каждом
# заходе. Год `immutable` убирает и их.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html обязан проверяться каждый заход: в нём имена тех самых хэшированных
# чанков, и устаревший HTML — это та самая ошибка «чанк не найден» после редиплоя.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Картинки и файлы роботов. То, что не названо в этом файле, Pages отдаёт с
# max-age=0, must-revalidate — замер 2026-11-17 по живому адресу прошлого
# деплоя (в той сборке `_headers` не было вовсе): `/og.png` отвечает именно так,
# `/robots.txt` — тоже, и заодно 200 с `text/html`, потому что вместо файла
# приходил fallback. Год этим файлам нельзя: их правят руками, и имя от
# содержимого не зависит. Сутки на визитку, час на правила для робота: столько
# стоит устаревшая картинка в превью мессенджера и столько же — запоздалый
# запрет в robots.
/og.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Камера, микрофон, гео и платёжный API приложению не нужны ни на одной панели;
  # пустой список — это и есть разрешение «ни себе, ни вложенным фреймам».
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=()
  Strict-Transport-Security: max-age=31536000
  # frame-ancestors здесь нет намеренно: мини-апп открывается внутри Telegram,
  # а родительский origin у веб-, десктоп- и мобильной клиентов различается, и с
  # неверным списком канал отдачи ломается молча — страница просто не встраивается.
  # Пока список не проверен на живом мини-аппе, ограничивать встраивание нечем:
  # X-Frame-Options тоже не вариант по той же причине.
  # Политика пока в Report-Only, и причина измерена, а не предполагана:
  # telegram-widget.js вызывает new Function сам (window.__parseFunction,
  # telegram-widget.js?22:6), поэтому enforce-версия без 'unsafe-eval' роняет
  # вход через Telegram, а 'unsafe-eval' в политике всей страницы разрешает
  # исполнение любой строки и у уязвимого места, а не только у виджета.
  # Решение за человеком: либо изолировать виджет в отдельном iframe со своей
  # политикой, либо жить без enforce-CSP. Проверка — scripts/headers-check.mjs.
  # Разрешений на blob: в политике нет, и это не недосмотр: в собранном бандле
  # (19 JS-файлов этого билда) `new Worker`, `SharedWorker`,
  # `navigator.serviceWorker` и `createObjectURL` не встречаются ни разу — 0 совпадений.
  # Ни воркер, ни blob-ссылка появиться не могут, а `blob:` в worker-src или img-src —
  # это как раз та строка, которой пользуются XSS-попапы, чтобы исполнить своё. Если
  # воркер когда-нибудь появится, `default-src 'self'` пропустит одностроничный, а
  # `npm run check:headers` увидит нарушение сам.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://explorer-api.walletconnect.com https://assets.reown.org; font-src 'self' data:; connect-src 'self' https://mainnet.zklighter.elliot.ai https://testnet.zklighter.elliot.ai https://api.arcus.xyz https://api.testnet.arcus.xyz https://wake-backend-production-3483.up.railway.app https://4byte.sourcify.dev https://eth.llamarpc.com wss://relay.walletconnect.org https://api.web3modal.org https://explorer-api.walletconnect.com https://*.ingest.sentry.io http://localhost:8787 http://127.0.0.1:8787; frame-src 'self' https://telegram.org https://oauth.telegram.org https://h.walletconnect.org https://secure.walletconnect.org; object-src 'none'; base-uri 'self'; form-action 'self'
