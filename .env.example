# Скопируй в .env для фронтенда. Vite читает VITE_* переменные из .env в корне.
# Без .env сборка живёт на дефолтах src/lib/config.ts: mainnet Lighter, бэкенд —
# развёрнутый сервис на Railway, signing service — локальный :8787 (в образ фронта
# он не входит и поднимается отдельно). Значения ниже переопределяют их для
# локальной разработки. Разойдись сети в фронте и в бэкенде, и страница с ботом
# показали бы разные market ids.

VITE_LIGHTER_NETWORK=mainnet
VITE_BACKEND_URL=http://localhost:8000
VITE_SIGNING_SERVICE_URL=http://localhost:8787

# Project id из https://cloud.walletconnect.com — нужен для QR-подключения
# кошелька. Пустой = коннектора нет вообще, injected-кошелёк (MetaMask, Rabby)
# работает и без него.
VITE_WALLETCONNECT_PROJECT_ID=

# Имя бота без @ — по нему Telegram Login Widget проверяет подпись. Пустое значение
# выключает панель входа через Telegram (кнопки нет вместо кнопки, которая 401).
# Для боевого сайта это waketrade_bot; значение зашивается в бандл, и сборка с
# пустым или чужим именем видна на проде сразу: панель пишет, что вход выключен.
VITE_TELEGRAM_BOT_NAME=

# Sentry DSN — оставляй пустым, пока проект не подключён: ключ-заглушка даёт
# ошибки при инициализации и не отправляет ничего.
VITE_SENTRY_DSN=

# ── Backend (backend/.env) ────────────────────────────────────────────────────
# PostgreSQL (async). Формат: postgresql+asyncpg://user:pass@host:port/dbname
# В docker-compose тот же стек уже настроен на
# postgresql+asyncpg://wake:wake@postgres:5432/wake
# WAKE_DATABASE_URL=postgresql+asyncpg://wake:wake@localhost:5432/wake

# Redis для кэша и rate limiting
# WAKE_REDIS_URL=redis://localhost:6379/0

# Telegram bot token (get from @BotFather)
# TELEGRAM_BOT_TOKEN=
