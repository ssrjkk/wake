# Скопируй в .env для фронтенда. Vite читает VITE_* переменные из .env в корне.
# Без .env фронтенд работает на mainnet Lighter + локальные backend (8000) и
# signing service (8787) — те же дефолты, что в backend/config.py. Разойдись они
# по сети, и страница с ботом показали бы разные market ids.

VITE_LIGHTER_NETWORK=mainnet
VITE_BACKEND_URL=http://localhost:8000
VITE_SIGNING_SERVICE_URL=http://localhost:8787

# Project id из https://cloud.walletconnect.com — нужен для QR-подключения
# кошелька. Пустой = коннектора нет вообще, injected-кошелёк (MetaMask, Rabby)
# работает и без него.
VITE_WALLETCONNECT_PROJECT_ID=

# Telegram bot name for login widget (get from @BotFather)
VITE_TELEGRAM_BOT_NAME=

# Sentry DSN — оставляй пустым, пока проект не подключён: ключ-заглушка даёт
# ошибки при инициализации и не отправляет ничего.
VITE_SENTRY_DSN=

# ── Backend (backend/.env) ────────────────────────────────────────────────────
# PostgreSQL (async). Формат: postgresql+asyncpg://user:pass@host:port/dbname
# В docker-compose уже настроен postgres://wake:wake@postgres:5432/wake
# WAKE_DATABASE_URL=postgresql+asyncpg://wake:wake@localhost:5432/wake

# Redis для кэша и rate limiting
# WAKE_REDIS_URL=redis://localhost:6379/0

# Telegram bot token (get from @BotFather)
# TELEGRAM_BOT_TOKEN=
