# Скопируй в .env, заполни реальными значениями, НИКОГДА не коммить .env в git
# (см. .gitignore — он уже это исключает).

LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=0
LIGHTER_API_KEY_PRIVATE_KEY=

# Сгенерировать: python3 -c "from encrypted_key_store import generate_master_key; print(generate_master_key())"
# Хранить в реальном секрет-менеджере (Vault/KMS/облачный secrets manager), не здесь —
# .env на диске сервера сам по себе не является безопасным хранилищем этого значения.
WAKE_MASTER_KEY=

# true = ни один реальный ордер не уйдёт, только логирование. Значение по умолчанию
# в коде — true. Осознанно менять на false может только тот, кто прошёл
# GO-LIVE-CHECKLIST.md целиком.
WAKE_DRY_RUN=true

# --- AI-агент (llm_agent.py) ---
ANTHROPIC_API_KEY=

# --- Копи-движок (leader_listener.py) ---
LIGHTER_WS_URL=wss://testnet.zklighter.elliot.ai/stream
WAKE_SIGNING_SERVICE_URL=http://localhost:8787

# --- Хранилище ключей (key_store.py / kms_key_store.py) ---
WAKE_DEV_KEYSTORE_PATH=dev_keystore.local.json
WAKE_KEYSTORE_PATH=keystore.enc
WAKE_KMS_KEY_ID=

# --- Postgres (db_postgres.py) — только для реального масштаба, не для локальной разработки ---
WAKE_DATABASE_URL=

# --- Stripe (stripe_billing.py) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
