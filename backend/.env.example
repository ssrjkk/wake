# Скопируй в .env (он в .gitignore), заполни реальными значениями. Пустое поле
# означает «не задано» — код тогда берёт свой дефолт, он указан в комментарии.

# --- Сеть Lighter ---
# mainnet или testnet. Дефолт в коде — mainnet: тестнет как умолчание был
# источником неверных чисел (лимиты рынка брались из тестнет-книги, price-рынки
# резолвились ценой тестовой сети).
WAKE_LIGHTER_NETWORK=mainnet

# REST и WS считаются из имени сети (backend/config.py, LIGHTER_HOSTS). Задавай
# их вручную, только если уходишь с zklighter.elliot.ai:
# LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
# LIGHTER_WS_URL=wss://mainnet.zklighter.elliot.ai/stream

# --- Ключ для подписи (signing_service.py) ---
# LIGHTER_API_KEY_PRIVATE_KEY — api key с app.lighter.xyz, НЕ приватный ключ кошелька.
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=0
LIGHTER_API_KEY_PRIVATE_KEY=

# --- Что бэкенд разрешает из браузера ---
# Через запятую. Дефолт — http://localhost:5173. Фронт, поднятый на другом
# порту или хосте, без этой переменной получает «Failed to fetch» на каждом
# запросе: браузер блокирует ответ, а не бэкенд его не отдаёт.
WAKE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Файловая база ---
# Пути относительные, считаются от cwd — поэтому бэкенд запускают из backend/.
WAKE_DB_PATH=wake.db
WAKE_AUDIT_DB_PATH=audit.db

# --- Токен куратора ---
# Нужен для создания event-рынков и их резолюции (api/predict.py, _require_curator):
# без заголовка X-Curator-Token эти эндпоинты отдают 401.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
WAKE_CURATOR_TOKEN=

# --- Telegram-бот (telegram_bot.py) ---
# TELEGRAM_BOT_TOKEN нужен и боту, и бэкенду: api/auth.py проверяет им подписи
# и Login Widget, и initData мини-аппа. Без него Telegram-вход отвечает 503.
TELEGRAM_BOT_TOKEN=
# Кнопка «Открыть Wake» открывает этим сайтом вебвью; для Telegram адрес обязан
# быть https.
WAKE_MINIAPP_URL=http://localhost:5173/
WAKE_BACKEND_URL=http://localhost:8000

# --- Хранилище ключей ---
# python -c "from encrypted_key_store import generate_master_key; print(generate_master_key())"
# Держать в реальном секрет-менеджере (Vault/KMS/облачный secrets manager), не
# здесь: .env на диске сервера сам по себе не является безопасным хранилищем.
WAKE_MASTER_KEY=
WAKE_DEV_KEYSTORE_PATH=dev_keystore.local.json
WAKE_KEYSTORE_PATH=keystore.enc
WAKE_KMS_KEY_ID=

# --- Реальные ордера ---
# true = ни один ордер не уходит на биржу, только запись в лог. Дефолт в коде —
# true. На false переключает тот, кто проверил на своём аккаунте путь ордера
# целиком: dry_run выключен — это уже торговля живыми деньгами.
WAKE_DRY_RUN=true

# --- Копи-движок (leader_listener.py) ---
WAKE_SIGNING_SERVICE_URL=http://localhost:8787

# --- Авто-резолвер price-рынков (predict_resolver.py) ---
# Тик процесса-резолвера в секундах (дефолт в коде — 300). Эндпоинт
# /predict/markets/{id}/resolve-price работает без него: резолвер — отдельный
# процесс (python predict_resolver.py --loop), без запущенного рынка по дедлайну
# не закроется, пока куратор не дёрнет ручной триггер.
WAKE_PREDICT_RESOLVER_TICK=300

# --- AI-агент (llm_agent.py) ---
ANTHROPIC_API_KEY=

# --- Логи и rate limit ---
# DEBUG/INFO/WARNING/ERROR. Лимит: ёмкость корзины + восстановлений в секунду;
# числа — отправная точка, на реальном трафике их калибруют по факту.
WAKE_LOG_LEVEL=INFO
WAKE_RATE_LIMIT_CAPACITY=40
WAKE_RATE_LIMIT_REFILL=20

# --- Sentry (app.py) ---
# Пустой = интеграция не поднимается вообще, это дефолт. Метка окружения нужна,
# чтобы ошибки тестового инстанса не смешивались с продакшн в одном проекте.
SENTRY_DSN=
WAKE_ENV=local

# --- Только ручного скрипта place_order_example.py ---
# Этот скрипт выставляет настоящий ордер, поэтому его дефолтная сеть — testnet,
# хотя бэкенд по умолчанию на mainnet. Переменные читаются только в нём.
WAKE_ORDER_SYMBOL=ETH
WAKE_ORDER_SIZE_USD=100
WAKE_ORDER_SIDE=buy
