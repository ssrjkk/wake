# Скопируй в .env (он в .gitignore), заполни реальными значениями. Пустое поле
# означает «не задано» — код тогда берёт свой дефолт, он указан в комментарии.

# --- Сеть Lighter ---
# mainnet или testnet. Дефолт в коде — mainnet: тестнет как умолчание был
# источником неверных чисел (лимиты рынка брались из тестнет-книги, price-рынки
# резолвились ценой тестовой сети).
WAKE_LIGHTER_NETWORK=mainnet

# REST и WS Lighter выводятся из имени сети (backend/config.py, LIGHTER_HOSTS) и
# наружу не настраиваются: LIGHTER_BASE_URL и LIGHTER_WS_URL код не читает, и
# задать их здесь — значит получить переменную, которая молча ничего не меняет.
# Сменить хост можно только в LIGHTER_HOSTS в config.py — специально, чтобы
# подпись ордеров не уехала на произвольный адрес одной строкой в env.

# --- Ключ для подписи (signing_service.py) ---
# LIGHTER_API_KEY_PRIVATE_KEY — api key с app.lighter.xyz, НЕ приватный ключ кошелька.
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=0
LIGHTER_API_KEY_PRIVATE_KEY=

# Хосты, которым сервис подписи отвечает вообще. У /place-order нет
# аутентификации (секрет в публичном бандле — не секрет), поэтому единственная
# граница — адрес, под которым сервис опубликован: запросы на любой другой Host
# получают 403 SIGNING_HOST_NOT_ALLOWED до прикосновения к ключу. Дефолт в коде —
# localhost,127.0.0.1,::1,signing (последнее — имя сервиса из docker-compose).
# Портище нет: добавлять сюда публичное имя значит своими руками открыть
# эндпоинт, который двигает деньги этого аккаунта (см. docs/RAILWAY_DEPLOY.md §1.1).
WAKE_SIGNING_ALLOWED_HOSTS=localhost,127.0.0.1,::1,signing

# --- Что бэкенд разрешает из браузера ---
# Через запятую. Дефолт — http://localhost:5173. Фронт, поднятый на другом
# порту или хосте, без этой переменной получает «Failed to fetch» на каждом
# запросе: браузер блокирует ответ, а не бэкенд его не отдаёт.
WAKE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- База и Redis ---
# Единственная база — PostgreSQL: подписки, копи-трейдинг, рынки предсказаний,
# аудит. Файловой SQLite больше нет: он переживал рестарт контейнера только с
# примонтованным диском, а ON CONFLICT с указанием индекса, строка под FOR UPDATE
# и регистрозависимый LIKE на нём не исполняются.
# Дефолт в коде — postgresql+asyncpg://wake:wake@localhost:5432/wake
WAKE_DATABASE_URL=postgresql+asyncpg://wake:wake@localhost:5432/wake
# Дефолт в коде — redis://localhost:6379/0. Без Redis middleware не считает
# rate limit, а /ready отвечает 503.
WAKE_REDIS_URL=redis://localhost:6379/0
# true — SQLAlchemy печатает каждый запрос. Только для отладки: в логе вместе с
# запросами оказываются значения параметров, включая адреса кошельков.
WAKE_DB_ECHO=false
# Схема поднимается миграциями, а не приложением: alembic upgrade head
# (см. backend/alembic). Приложение не делает DDL и не ждёт, что таблицы есть.
# Тестовая база — отдельная: тесты создают схему через create_all и очищают
# таблицы truncate'ом, и в боевой базе им делать нечего. Переменная обязательна
# для test_*.py — без неё тестовый кейс падает с подсказкой, а не молча.
# createdb wake_test
WAKE_TEST_DATABASE_URL=postgresql+asyncpg://wake:wake@localhost:5432/wake_test

# --- Сессия (session.py) ---
# Подписанный HMAC-токен вместо user_id из запроса. Без секрета выдача токена
# отвечает 503 — угадываемым ключом токены не подписываются. Локальному стеку
# нужна заглушка, проду — значение из секрет-менеджера.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
WAKE_SESSION_SECRET=
# Срок жизни токена в днях, разумный диапазон 1–180 (дефолт в коде — 30).
WAKE_SESSION_TTL_DAYS=7

# --- Кому доверять X-Forwarded-For ---
# IP клиентов через запятую. За Railway/Cloudflare адрес соединения — адрес
# прокси, и без этого все клиенты делят один bucket rate limit и одну запись в
# аудите. Задавай только реально свои адреса: X-Forwarded-For пишется клиентом
# как ему вздумается, и доверять ему без проверки источника — способ выдать
# свой IP за чужой.
WAKE_TRUSTED_PROXY_IPS=

# --- Токен куратора ---
# Операторский доступ: создание price- и event-рынков, их резолюция, ручной прогон
# копи-движка, апгрейд подписки. Проверяется один раз в api/guards.py
# (require_curator) по заголовку X-Curator-Token: без заголовка или с чужим — 403
# CURATOR_TOKEN_INVALID, а если токен не настроен на сервере — 500
# CURATOR_NOT_CONFIGURED, чтобы пустая конфигурация не открыла создание рынков.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
WAKE_CURATOR_TOKEN=

# --- Telegram-бот (telegram_bot.py) ---
# TELEGRAM_BOT_TOKEN нужен и боту, и бэкенду: api/auth.py проверяет им подписи
# и Login Widget, и initData мини-аппа. Без него Telegram-вход отвечает 503, а
# сам бот не поднимается. При старте бот проставляет этим токеном меню команд
# (set_my_commands) — без него автодополнение по «/» пустое.
TELEGRAM_BOT_TOKEN=
# Кнопка «Открыть Wake» открывает этим адресом вебвью; Telegram принимает только
# https и отбраковывает http на валидации ответа, поэтому с локальным адресом бот
# просто не ставит кнопку (и пишет об этом в /start), а не падает на каждом
# сообщении. Для прод-сборки это адрес Pages.
WAKE_MINIAPP_URL=http://localhost:5173/
# Откуда бот берёт Predict-рынки: это единственный раздел, которому нужен бэкенд
# (рынки живут в базе Wake). /price, /markets и /funding считаются напрямую по
# публичному REST Lighter тем же кодом, что и у сайта, и работают без бэкенда.
# Внутри docker-compose это http://app:8000 — localhost в контейере бота пустой.
WAKE_BACKEND_URL=http://localhost:8000

# --- Хранилище ключей ---
# python -c "from encrypted_key_store import generate_master_key; print(generate_master_key())"
# Держать в реальном секрет-менеджере (Vault/KMS/облачный secrets manager), не
# здесь: .env на диске сервера сам по себе не является безопасным хранилищем.
WAKE_MASTER_KEY=
# Ключи подписчиков кладут в этот файл только через CLI:
# `python -m encrypted_key_store store <follower_id> <api_key_index>` — секрет
# читается из stdin, не из аргументов (argv остаётся в истории shell и в списке
# процессов). HTTP-роута, принимающего ключ, нет намеренно.
WAKE_KEYSTORE_PATH=keystore.enc

# --- Реальные ордера ---
# true = ни один ордер не уходит на биржу, только запись в лог. Дефолт в коде —
# true. На false переключает тот, кто проверил на своём аккаунте путь ордера
# целиком: dry_run выключен — это уже торговля живыми деньгами.
WAKE_DRY_RUN=true
# Вторая ручка, только для mainnet: dry_run=false на основной сети без неё не
# поднимается — процесс падает на старте с объяснением. На тестнете выключать
# dry_run можно и так: проверять путь ордера надо именно там.
WAKE_MAINNET_LIVE=false

# --- Копи-агент (agent_runner.py) ---
# Куда агент кладёт подписанный ордер. Раньше читался прямой os.environ, и
# значение из этого файла агент не видел — ходил на localhost, даже когда здесь
# стоял другой адрес. Теперь переменная проходит через config.py, как всё
# остальное. Сервис подписи — отдельный процесс (signing_service.py).
WAKE_SIGNING_SERVICE_URL=http://localhost:8787

# --- Swagger (app.py) ---
# /docs, /redoc и /openapi.json существуют только при true. Причина не
# скрытность, а заголовок CSP этого же приложения (`default-src 'self'`):
# swagger-ui грузит скрипт с CDN и пишет инлайновый тег, поэтому под таким
# заголовком он отдаёт пустую страницу. Включай локально, где сам решаешь, что
# смотреть документацию процесса; в проде путь закрыт и схема не раздаётся
# сканерам.
WAKE_ENABLE_DOCS=false

# --- Авто-резолвер price-рынков (predict_resolver.py) ---
# Тик процесса-резолвера в секундах (дефолт в коде — 300, ноль и меньше
# отклоняются на старте). Эндпоинт /predict/markets/{id}/resolve-price работает
# без него: резолвер — отдельный процесс (python predict_resolver.py --loop),
# без запущенного рынка по дедлайну не закроется, пока куратор не дёрнет ручной
# триггер.
WAKE_PREDICT_RESOLVER_TICK=300

# --- AI-агент (llm_agent.py) ---
# Пустой ключ — и агент остаётся на правилном решении с пометкой в reasoning,
# а не молча. Значение из .env теперь доходит и до llm_agent.
ANTHROPIC_API_KEY=

# --- Логи и rate limit ---
# DEBUG/INFO/WARNING/ERROR. Лимит: ёмкость корзины + восстановлений в секунду;
# числа — отправная точка, на реальном трафике их калибруют по факту.
WAKE_LOG_LEVEL=INFO
WAKE_RATE_LIMIT_CAPACITY=40
WAKE_RATE_LIMIT_REFILL=20

# --- Sentry (app.py) ---
# Пустой = интеграция не поднимается вообще, это дефолт. Метка окружения нужна,
# чтобы ошибки тестового инстанса не смешивались с продакшн в одном проекте.
SENTRY_DSN=
WAKE_ENV=local

# --- Только ручного скрипта place_order_example.py ---
# Этот скрипт выставляет настоящий ордер, поэтому его дефолтная сеть — testnet,
# хотя бэкенд по умолчанию на mainnet. Переменные читаются только в нём.
# На mainnet скрипт не идёт без второго подтверждения: WAKE_LIGHTER_NETWORK=mainnet
# — настройка данных, а не разрешение тратить живые деньги, поэтому нужен ещё и
# WAKE_MAINNET_LIVE=true (та же пара флагов, что сторожит весь остальной продукт).
WAKE_ORDER_SYMBOL=ETH
WAKE_ORDER_SIZE_USD=100
# buy | sell — любое другое значение скрипт отвергает, а не трактует как buy.
WAKE_ORDER_SIDE=buy
